{
    "name": "jeffersongoncalves/filament-metrics-ga4",
    "description": "Filament plugin with Google Analytics 4 dashboard widgets (realtime visitors, visitors chart, top pages, sources, countries, browsers and devices) and a Settings Page powered by Spatie Laravel Settings.",
    "keywords": [
        "jeffersongoncalves",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-metrics-ga4",
        "ga4",
        "analytics",
        "metrics",
        "widgets",
        "spatie-laravel-settings"
    ],
    "homepage": "https://github.com/jeffersongoncalves/filament-metrics-ga4",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0",
        "jeffersongoncalves/filament-analytics-core": "^1.1",
        "jeffersongoncalves/laravel-metrics-ga4": "^1.0",
        "spatie/laravel-package-tools": "^1.14.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Filament\\MetricsGA4\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Filament\\MetricsGA4\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Filament\\MetricsGA4\\GA4MetricsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
